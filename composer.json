{
    "name": "crustum/openrouter",
    "description": "OpenRouter plugin for CakePHP applications",
    "type": "cakephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.3",
        "cakephp/cakephp": "^5.1",
        "crustum/plugin-manifest": "^1.0",
        "guzzlehttp/guzzle": "^7.9",
        "caseyamcl/guzzle_retry_middleware": "^2.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "cakephp/cakephp-codesniffer": "^5.0",
        "cakephp/bake": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\OpenRouter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crustum\\OpenRouter\\Test\\": "tests/"
        }
    },
    "scripts": {
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": "phpunit --coverage-html coverage",
        "stan": "tools/phpstan analyse src/",
        "psalm": "tools/psalm --show-info=false",
        "stan-tests": "tools/phpstan analyze -c tests/phpstan.neon",
        "stan-baseline": "tools/phpstan --generate-baseline"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "platform-check": false
    }
}
